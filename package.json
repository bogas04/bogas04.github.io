{
  "name": "bogas04.github.io",
  "description": "Divjot's personal website",
  "version": "0.0.25",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "start": "pnpm gallery:build && next dev",
    "write": "node scripts/open-authoring.mjs write",
    "upload": "node scripts/open-authoring.mjs upload",
    "build": "pnpm run gallery:check && pnpm run gallery:build && pnpm run build:site",
    "build:site": "make build",
    "generate:rss": "node --no-warnings ./scripts/generate-rss.ts",
    "refresh:friends": "node --no-warnings ./scripts/refresh-friend-updates.ts",
    "generate:sitemap": "node --no-warnings ./scripts/generate-sitemap.ts",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "gallery:add": "node --no-warnings scripts/gallery-add.ts",
    "gallery:build": "node --no-warnings scripts/gallery-build.ts",
    "gallery:check": "node --no-warnings scripts/gallery-check.ts",
    "gallery:check:staged": "node --no-warnings scripts/gallery-check-staged-images.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "^16.3.5",
    "parse5": "^6.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.6",
    "prism-themes": "^1.6.0",
    "remark": "^13.0.0",
    "remark-autolink-headings": "^6.0.1",
    "remark-html": "^13.0.1",
    "remark-prism": "^1.3.4",
    "remark-slug": "^6.0.0",
    "slugify": "^1.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.0"
  },
  "prettier": {
    "semi": true,
    "useTabs": false,
    "tabWidth": 2
  }
}
